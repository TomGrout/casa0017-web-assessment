# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=casa0017_sewage
DB_PORT=3306
DB_SSL=false

# External APIs
THAMES_WATER_API_URL=https://api.thameswater.co.uk/opendata/v2/discharge/status
ENVIRONMENT_AGENCY_URL=https://environment.data.gov.uk/flood-monitoring

# Cron Jobs
CRON_ENABLED=true
CRON_SCHEDULE=*/15 * * * *

CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- River spill map
# Public URL of the frontend, used in WhatsApp messages (forecast links)
PUBLIC_MAP_URL=http://localhost:5173
# Model inputs are cached this long for all browsers (Thames Water updates ~every 15 min)
RIVER_INPUTS_CACHE_MINUTES=10
# The rain forecast is reused this long (Open-Meteo free limit: under 10,000 location-calls a day),
# and an older copy may be used for this many hours if Open-Meteo cannot be reached
# RIVER_RAIN_CACHE_MINUTES=60
# RIVER_RAIN_STALE_HOURS=6
# Spill history window used for each overflow's spill propensity (spill_event table)
RIVER_PROPENSITY_DAYS=365
# Most overflows read from the team rainfall-threshold analysis for the live map forecast
# RIVER_THRESHOLDS_MAX=20000
# Server-side model run + WhatsApp updates
RIVER_ALERTS_ENABLED=true
RIVER_ALERTS_SCHEDULE=*/15 * * * *

# WhatsApp Cloud API (Meta). Without WHATSAPP_TOKEN everything runs in DRY_RUN (messages are logged).
DRY_RUN=1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GRAPH_VERSION=v21.0

# Google reCAPTCHA v3 for public sighting reports (pair with VITE_RECAPTCHA_SITE_KEY in frontend/.env)
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_HOSTNAMES=

# Moderators hide a sighting with: DELETE /api/river/sightings/:id  (header x-admin-token)
ADMIN_TOKEN=

# Optional upstream overrides (testing)
# EASYTIDE_BASE_URL=https://easytide.admiralty.co.uk
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
